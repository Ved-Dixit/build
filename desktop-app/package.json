{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "Buildio - Local AI Code Generator",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ved-Dixit/build.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build": "tsc -p electron/tsconfig.json && vite build && electron-builder --publish always",
    "build:all": "tsc -p electron/tsconfig.json && vite build && electron-builder --mac --win --linux --publish always"
  },
  "build": {
    "appId": "com.buildio.app",
    "productName": "Buildio",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "artifactName": "buildio-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "buildio-windows.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "artifactName": "buildio-linux.${ext}"
    }
  },
  "keywords": [],
  "author": "Ved Dixit <veddixit195@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@huggingface/hub": "^2.11.2",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "node-llama-cpp": "^3.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "wait-on": "^9.0.5"
  }
}
